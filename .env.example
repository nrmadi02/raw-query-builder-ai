# ── Database (Remote PostgreSQL) ──
DATABASE_URL="postgresql://user:password@host:5432/ai_query_builder?schema=public"
DATABASE_QUERY_URL="postgresql://user:password@host:5432/postgres"

# ── Better Auth ──
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.com"

# ── Google OAuth ──
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── LiteLLM Proxy (optional) ──
LITELLM_URL="http://localhost:4000"
LITELLM_MASTER_KEY="sk-1234"
LITELLM_API_KEY="sk-1234"

# ── AI Provider Keys (fill what you use) ──
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# ── Zhipu AI ──
ZHIPU_API_KEY=""
ZHIPU_BASE_URL="https://api.z.ai/api/coding/paas/v4"
ZHIPU_MODEL="glm-5-turbo"

# ── Backend ──
# Note: In Docker, this is auto-set to http://python-backend:8000
# Only set this if running Next.js outside Docker
PYTHON_BACKEND_URL="http://localhost:8000"
ALLOWED_ORIGINS="https://your-domain.com"
